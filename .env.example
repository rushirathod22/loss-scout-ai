# Losscope AI — Environment Variables
# Copy this file to .env and fill in your values.

# OpenAI API key for the AI narrator feature.
# The app works fully without it — the deterministic analysis engine
# runs locally, and a structured fallback summary is generated.
# Set this to enable AI-powered executive summaries and reasoning.
OPENAI_API_KEY=your_openai_api_key_here
